# ===== Zahanati Digital: copy to .env and fill in. NEVER commit .env =====
FLASK_ENV=development                 # production in Docker
SECRET_KEY=                           # 32+ random characters: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET_KEY=                       # 32+ random characters (different from SECRET_KEY)
DATABASE_URL=postgresql+psycopg2://zahanati:zahanati@localhost:5432/zahanati
DB_PASSWORD=                          # Docker Compose only
CORS_ORIGINS=http://localhost:3000    # comma-separated web origins allowed to call the API
RATELIMIT_STORAGE_URI=memory://       # redis://redis:6379/0 in production (shared between workers)
PROXY_HOPS=0                          # 1 when behind nginx/Caddy
DEFAULT_LANGUAGE=en                   # language of API messages when the client sends none (sw|en)
SWAGGER_ENABLED=true                  # /api/docs/ and /api/openapi.json
FEATURE_APPOINTMENTS=true             # set false to switch off doctor appointments

# --- tokens
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- SMS (OTP + notifications)
SMS_PROVIDER=console                  # console = prints codes in the server log (development ONLY); beem in production
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SOURCE_ADDR=
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LOCK_SECONDS=600

# --- encrypted files and HEDHI data
FILE_ENCRYPTION_KEYS=                 # run: flask generate-fernet-key   (comma-separate several keys to rotate; BACK THEM UP)
UPLOAD_DIR=instance/prescriptions
PRESCRIPTION_RETENTION_DAYS=730
HEDHI_INACTIVITY_DAYS=730

# --- orders and payments
ORDER_EXPIRY_HOURS=24
ORDER_MAX_ITEMS=20
ORDER_MAX_ITEM_QUANTITY=20
PAYMENT_PROVIDER=simulator            # only 'simulator' exists until a provider adapter is written (see docs/DEPLOYMENT.md)
ALLOW_PAYMENT_SIMULATOR=false         # true only for demos: lets production mode start with the simulator
PAYMENT_CALLBACK_SECRET=              # 24+ random characters shared with the payment provider
PAYMENT_NETWORKS=mpesa,tigopesa
PAYMENT_TIMEOUT_MINUTES=30

# --- appointments, chat, prescriptions
CLINIC_TIMEZONE=Africa/Dar_es_Salaam
APPOINTMENT_SLOT_MINUTES=30
APPOINTMENT_MIN_LEAD_MINUTES=60
APPOINTMENT_MAX_ADVANCE_DAYS=90
CHAT_REPLY_TARGET_HOURS=24
CHAT_MAX_MESSAGE_CHARS=2000
PRESCRIPTION_VALID_DAYS=90
